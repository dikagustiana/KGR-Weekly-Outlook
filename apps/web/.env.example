# Supabase project (Settings → API). The publishable/anon key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable or anon key>
# Optional: show "Masuk dengan Google" once the Google provider is enabled in Supabase Auth.
NEXT_PUBLIC_AUTH_GOOGLE=0
