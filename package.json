{
  "name": "kgr-weekly-outlook",
  "private": true,
  "description": "KGR Weekly Outlook \u2014 PT Karya Gudang Rabat (SAMB Group)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r --filter \"./packages/**\" test",
    "typecheck": "pnpm -r typecheck",
    "outlook": "tsx packages/engine/src/cli.ts",
    "fixtures": "python3 -I scripts/extract_fixtures.py",
    "dev": "pnpm --filter @kgr/web dev",
    "build": "pnpm --filter @kgr/web build",
    "parity": "tsx packages/engine/scripts/parity.ts"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
